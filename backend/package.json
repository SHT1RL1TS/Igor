{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for Igor app",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/server.ts",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:serve": "npm run build && node test/serve.mjs"
  },
  "engines": { "node": ">=22.12" },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "pg": "^8.11.5",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.2",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3"
  }
}
